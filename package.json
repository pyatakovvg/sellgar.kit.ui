  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.2",
    "@types/react-slider": "1.3.6",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-lib-inject-css": "2.2.2",
    "vite-plugin-webfont-dl": "3.13.1"
  },
